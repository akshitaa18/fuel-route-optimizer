{
  "info": {
    "name": "Fuel Route Optimizer API",
    "_postman_id": "c1f7a4e0-9832-4e4b-91bb-2195df871234",
    "description": "Comprehensive Postman test collection for the Fuel Route Optimizer REST API, supporting route cost optimization, geocoding validation, corridor filtering, and fuel stop planning.",
