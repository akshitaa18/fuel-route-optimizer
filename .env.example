# Django Core Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key-for-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CORS Settings (when DEBUG=False, comma-separated allowed origins)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OSRM Driving Directions Service (public demo instance or private OSRM server)
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_TIMEOUT=15

# Geocoding Service Timeout (Seconds)
GEOCODING_TIMEOUT=10

# Vehicle & Route Defaults
DEFAULT_MAX_RANGE_MILES=500.0
DEFAULT_MPG=10.0
DEFAULT_TANK_CAPACITY_GALLONS=50.0
DEFAULT_CORRIDOR_MILES=5.0
DEFAULT_ORIGIN_REFUEL_RADIUS_MILES=25.0
