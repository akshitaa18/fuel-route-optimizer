  },
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health/",
          "host": ["{{base_url}}"],
          "path": ["api", "health", ""]
        },
        "description": "Checks system health, database connection, and loaded station count."
      },
      "response": []
    },
    {
      "name": "Optimize Route - New York to Los Angeles (Default)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\",\n  \"max_range\": 500,\n  \"miles_per_gallon\": 10,\n  \"corridor_miles\": 5\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/route/optimize/",
          "host": ["{{base_url}}"],
          "path": ["api", "route", "optimize", ""]
        },
        "description": "Calculates transcontinental driving route geometry, filters stations within 5-mile corridor, and runs Dynamic Programming optimization."
      },
      "response": []
    },
    {
